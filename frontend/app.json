{
  "expo": {
    "name": "Kerjo",
    "slug": "kerjo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kerjo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.kerjo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tampilkan kerja dan pekerja terdekat dari lokasimu"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E62429"
      },
      "package": "id.kerjo.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tampilkan kerja dan pekerja terdekat dari lokasimu"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Unggah foto profil dari galerimu"
        }
      ],
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
